---
import Layout from '../layouts/Layout.astro';
import LegalToc from '../components/LegalToc.astro';
import LegalSection from '../components/LegalSection.astro';
import LegalContactCard from '../components/LegalContactCard.astro';
import { termsSections } from '../data/legal-terms';
import { buildToc } from '../data/legal-types';

const toc = buildToc(termsSections, '19. Contact Information');
---

<Layout
  title="Terms of Service — U;Good?"
  description="The Terms of Service governing your access to and use of the U;Good? mobile application and related services."
  activeNav="terms"
>
  <section class="wrap page-header">
    <div class="eyebrow">Legal</div>
    <h1>U;Good? Terms of Service</h1>
    <p class="effective">Effective Date: June, 2026</p>
    <div class="intro">
      <p class="lede">
        Welcome to U;Good?, a social wellness platform owned and operated by <strong>Poundo, Inc.</strong>
        ("Poundo," "U;Good?," "we," "our," or "us").
      </p>
      <p>
        These Terms of Service ("Terms") govern your access to and use of the U;Good? mobile
        application, websites, messaging systems, integrations, APIs, content, and related services
        (collectively, the "Services").
      </p>
      <p>
        By creating an account, accessing, downloading, or using the Services, you agree to be bound
        by these Terms. If you do not agree, you may not use the Services.
      </p>
    </div>
  </section>

  <section class="wrap disclaimer-wrap">
    <div class="disclaimer">
      <div class="eyebrow">Important wellness disclaimer</div>
      <p>
        U;Good? is not a healthcare provider, mental health provider, or crisis-response service, and
        is not a substitute for professional care or emergency services.
        <a href="#s1" class="strong">Read the full disclaimer in section 1 →</a>
      </p>
    </div>
  </section>

  <section class="wrap legal-body">
    <LegalToc toc={toc} />
    <div class="sections">
      {termsSections.map((section) => (
        <LegalSection section={section} privacyHref="/privacy" />
      ))}
      <LegalContactCard
        eyebrow="19. Contact Information"
        intro="Questions regarding these Terms may be directed to:"
        department="Legal Department"
      />
    </div>
  </section>
</Layout>

<style>
  .page-header {
    padding: 48px 24px 24px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  h1 {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: clamp(34px, 4.6vw, 52px);
    line-height: 1.05;
    letter-spacing: -1.2px;
  }
  .effective {
    margin: 0;
    font-size: 14px;
    color: var(--ink-tertiary);
  }
  .intro {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: var(--prose-max);
  }
  .intro p {
    margin: 0;
    font-size: 16px;
    line-height: 1.65;
    color: var(--ink-secondary);
  }
  .intro .lede {
    font-size: 17px;
    line-height: 1.6;
    text-wrap: pretty;
  }
  .intro strong {
    font-weight: 600;
    color: var(--ink);
  }

  .disclaimer-wrap {
    padding: 8px 24px 40px;
  }
  .disclaimer {
    background: var(--surface-blue-tint);
    border-radius: 20px;
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 820px;
  }
  .disclaimer p {
    margin: 0;
    font-size: 16px;
    line-height: 1.65;
    color: var(--ink);
    text-wrap: pretty;
  }
  .strong {
    font-weight: 600;
  }

  .legal-body {
    padding: 0 24px 88px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 56px;
    align-items: start;
  }
  .sections {
    display: flex;
    flex-direction: column;
    gap: 44px;
    min-width: 0;
  }
</style>
