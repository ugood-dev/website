---
import Layout from '../layouts/Layout.astro';
import StoreBadges from '../components/StoreBadges.astro';
import PhoneMock from '../components/PhoneMock.astro';
import CrisisCard from '../components/CrisisCard.astro';
import { features, faqTeaser, circleFacts, spaceFacts } from '../data/landing';
---

<Layout
  title="U;Good? — How are you, really?"
  description="U;Good? is a quiet little app for checking in with the people you trust. Pick a color, say as much or as little as you want, and let your circle know how you're doing."
>
  <section class="hero wrap">
    <div class="hero-copy">
      <div class="mood-dots">
        <span class="dot" style="background:#34A853"></span>
        <span class="dot" style="background:#FBBC05"></span>
        <span class="dot" style="background:#EA4335"></span>
      </div>
      <h1>How are you, really?</h1>
      <p class="lede">
        U;Good? is a quiet little app for checking in with the people you trust. Every interaction is a
        single tap — there is no chat, no feed, and nothing to write.
      </p>
      <div id="download" class="download">
        <StoreBadges variant="dark" />
      </div>
      <p class="caption">
        On iPhone and Android. Access is invite-only: enter a 6-digit invite code, or join the waitlist
        and we'll email you when it's your turn.
      </p>
    </div>
    <PhoneMock />
  </section>

  <section class="manifesto">
    <div class="wrap manifesto-inner">
      <div class="manifesto-head">
        <div class="headline">This isn't social media.</div>
        <div class="subhead">No likes. No performance. Just honesty.</div>
      </div>
      <div class="manifesto-body">
        <p>
          There's no feed to scroll, no follower count to grow, no post to get right. Just a color, a
          single tap, and a handful of people who actually care how you're doing.
        </p>
        <p>Only people you trust belong here.</p>
      </div>
    </div>
  </section>

  <section class="wrap how-it-works">
    <div class="section-head">
      <div class="eyebrow">How it works</div>
      <h2>A check-in is three taps, start to finish.</h2>
    </div>
    <div class="steps">
      <div class="card">
        <div class="motif dots">
          <span style="background:#98C1D9"></span>
          <span style="background:#3D5A80"></span>
        </div>
        <div class="card-title">1. Ask "U;Good?"</div>
        <p>A check-in is that one question. One tap sends it to anyone in your Circle, up to three times a day. In a Space, the admin asks the whole group at once.</p>
      </div>
      <div class="card">
        <div class="motif chips">
          <span class="chip">I'm Good</span>
          <span class="chip">Call Me</span>
        </div>
        <div class="card-title">2. They answer in one tap.</div>
        <p>Six fixed replies, no typing: I'm Good · No, I'm Not · Call Me · Text Me · I'm Tired · I'm Hungry.</p>
      </div>
      <div class="card">
        <div class="motif bars">
          <span style="width:26px;background:#3D5A80"></span>
          <span style="width:44px;background:#98C1D9"></span>
          <span style="width:18px;background:#E6E9ED"></span>
        </div>
        <div class="card-title">3. You see how to help.</div>
        <p>Their answer opens a screen made for it — "Priya wants you to call" — so support turns into something you actually do.</p>
      </div>
    </div>
  </section>

  <section class="wrap compare">
    <div class="section-head" style="max-width:600px">
      <div class="eyebrow">Two ways to stay close</div>
      <h2>Your Circle, and your Spaces.</h2>
    </div>
    <div class="compare-grid">
      <div class="compare-card">
        <div class="compare-head">
          <div class="compare-name">Circle</div>
          <p>Your personal list of trusted contacts. Flat, one-to-one, no roles.</p>
        </div>
        <div class="fact-list">
          {circleFacts.map((f) => (
            <div class="fact-row">
              <span class="fact-key">{f.k}</span>
              <span class="fact-value">{f.v}</span>
            </div>
          ))}
        </div>
      </div>
      <div class="compare-card">
        <div class="compare-head">
          <div class="compare-name">Space</div>
          <p>A private named group — Family, Roomies, Run Club — run by whoever made it.</p>
        </div>
        <div class="fact-list">
          {spaceFacts.map((f) => (
            <div class="fact-row">
              <span class="fact-key">{f.k}</span>
              <span class="fact-value">{f.v}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="wrap feature-grid">
    <h2>Everything you need. Nothing you don't.</h2>
    <div class="grid">
      {features.map((f) => (
        <div class="feature-card">
          <span class="dot" style={`background:${f.dot}`}></span>
          <div class="title">{f.title}</div>
          <p>{f.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="wrap crisis-band">
    <div class="crisis-copy">
      <div class="eyebrow">If it's a hard day</div>
      <h2>Log a rough mood, and help comes up on its own.</h2>
      <p>
        When you set your mood to something distressed, U;Good? immediately offers crisis lines for
        your country — no searching, no forms. It's also always there in Settings, whatever your mood
        says.
      </p>
    </div>
    <CrisisCard />
  </section>

  <section class="safety-band">
    <div class="wrap safety-inner">
      <div class="safety-copy">
        <div class="eyebrow">Trust &amp; safety</div>
        <h2>Safe by design, not by moderation.</h2>
        <p>
          There's no way to send anyone a message in U;Good?, because messages don't exist. Every
          interaction is a tap on a fixed option, which makes a lot of bad things structurally
          impossible.
        </p>
      </div>
      <div class="safety-cards">
        <div class="safety-card">
          <span class="dot"></span>
          <div>
            <div class="title">No strangers</div>
            <div class="body">Access is invite-only, and joining a Space needs the admin's approval. No public feed, no discovery, no stranger contact.</div>
          </div>
        </div>
        <div class="safety-card">
          <span class="dot"></span>
          <div>
            <div class="title">No chat</div>
            <div class="body">Nothing is typed anywhere in the app. Check-ins and replies are taps on predefined options, so there is no content to misuse.</div>
          </div>
        </div>
        <div class="safety-card">
          <span class="dot"></span>
          <div>
            <div class="title">No performance</div>
            <div class="body">No likes, no streaks, no audience. Ages 13+, with parental permission under 18.</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap faq-teaser">
    <div class="faq-head">
      <h2>Questions, answered.</h2>
    </div>
    <div class="faq-list">
      {faqTeaser.map((q) => (
        <div class="faq-item">
          <div class="q">{q.q}</div>
          <p class="a">{q.a}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="wrap closing-cta-wrap">
    <div class="closing-cta">
      <div class="headline">Ready to begin? Let's make checking in easy, fun, and full of care.</div>
      <StoreBadges variant="light" />
    </div>
  </section>
</Layout>

<style>
  .hero {
    padding: 40px 24px 64px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: 40px;
    align-items: center;
  }
  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: 22px;
    max-width: 520px;
  }
  .mood-dots {
    display: flex;
    gap: 8px;
  }
  .mood-dots .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }
  h1 {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: clamp(38px, 5vw, 60px);
    line-height: 1.05;
    letter-spacing: -1.2px;
  }
  .lede {
    margin: 0;
    font-size: 18px;
    line-height: 1.55;
    color: var(--ink-secondary);
    text-wrap: pretty;
  }
  .download {
    padding-top: 6px;
  }
  .caption {
    margin: 0;
    font-size: 13px;
    color: var(--ink-tertiary);
  }

  .manifesto {
    background: var(--brand);
    color: #fff;
  }
  .manifesto-inner {
    padding: 88px 24px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
    gap: 40px;
    align-items: end;
  }
  .manifesto-head {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .headline {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: clamp(34px, 4.5vw, 56px);
    line-height: 1.05;
    letter-spacing: -1px;
  }
  .subhead {
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: clamp(22px, 2.6vw, 30px);
    line-height: 1.25;
    color: var(--brand-secondary);
  }
  .manifesto-body {
    display: flex;
    flex-direction: column;
    gap: 18px;
    font-size: 17px;
    line-height: 1.6;
    color: var(--band-tint-deep);
    max-width: 460px;
  }
  .manifesto-body p {
    margin: 0;
  }

  .how-it-works {
    padding: 96px 24px 40px;
    display: flex;
    flex-direction: column;
    gap: 44px;
  }
  .section-head {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 560px;
  }
  .section-head h2,
  .feature-grid h2,
  .faq-head h2,
  .safety-copy h2 {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: clamp(28px, 3.4vw, 40px);
    line-height: 1.15;
    letter-spacing: -0.6px;
  }
  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr));
    gap: 24px;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 28px;
    border: 1px solid var(--border);
    border-radius: 20px;
    background: var(--surface);
  }
  .motif {
    height: 26px;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .motif.dots span {
    width: 26px;
    height: 26px;
    border-radius: 50%;
  }
  .motif.bars span {
    height: 10px;
    border-radius: 5px;
  }
  .motif.chips {
    gap: 6px;
  }
  .chip {
    border: 1px solid var(--brand-secondary);
    color: var(--brand);
    border-radius: 999px;
    padding: 3px 10px;
    font-size: 12px;
    font-weight: 500;
  }
  .card-title {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 22px;
  }
  .card p {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink-secondary);
  }

  .compare {
    padding: 56px 24px 40px;
    display: flex;
    flex-direction: column;
    gap: 36px;
  }
  .compare-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: 24px;
  }
  .compare-card {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 32px;
    border: 1px solid var(--border);
    border-radius: 22px;
    background: var(--surface);
  }
  .compare-head {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .compare-name {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 26px;
    letter-spacing: -0.4px;
  }
  .compare-head p {
    margin: 0;
    font-size: 15.5px;
    line-height: 1.55;
    color: var(--ink-secondary);
  }
  .fact-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .fact-row {
    display: grid;
    grid-template-columns: 110px minmax(0, 1fr);
    gap: 14px;
    align-items: start;
    padding-top: 12px;
    border-top: 1px solid #F0F2F4;
  }
  .fact-key {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.4px;
    text-transform: uppercase;
    color: var(--ink-tertiary);
  }
  .fact-value {
    font-size: 15px;
    line-height: 1.5;
    color: var(--ink);
  }

  .feature-grid {
    padding: 56px 24px 96px;
    display: flex;
    flex-direction: column;
    gap: 36px;
  }
  .feature-grid h2 {
    max-width: 560px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
    gap: 20px;
  }
  .feature-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px;
    border-radius: 18px;
    background: var(--surface-tint);
  }
  .feature-card .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }
  .feature-card .title {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 18px;
    padding-top: 6px;
  }
  .feature-card p {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--ink-secondary);
  }

  .crisis-band {
    padding: 56px 24px 96px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: 48px;
    align-items: center;
  }
  .crisis-copy {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .crisis-copy h2 {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: clamp(28px, 3.4vw, 40px);
    line-height: 1.15;
    letter-spacing: -0.6px;
  }
  .crisis-copy p {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink-secondary);
    max-width: 480px;
  }

  .safety-band {
    background: var(--surface-blue-tint);
  }
  .safety-inner {
    padding: 88px 24px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
    gap: 48px;
  }
  .safety-copy {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .safety-copy p {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink-secondary);
    max-width: 460px;
  }
  .safety-cards {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .safety-card {
    display: flex;
    gap: 16px;
    padding: 22px 24px;
    background: var(--surface);
    border-radius: 16px;
  }
  .safety-card .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--brand);
    margin-top: 7px;
    flex: none;
  }
  .safety-card .title {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 17px;
  }
  .safety-card .body {
    font-size: 14.5px;
    line-height: 1.5;
    color: var(--ink-secondary);
    margin-top: 4px;
  }

  .faq-teaser {
    padding: 96px 24px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
    gap: 48px;
  }
  .faq-list {
    display: flex;
    flex-direction: column;
  }
  .faq-item {
    padding: 22px 0;
    border-top: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .faq-item .q {
    font-weight: 600;
    font-size: 17px;
  }
  .faq-item .a {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink-secondary);
  }

  .closing-cta-wrap {
    padding: 0 24px 96px;
  }
  .closing-cta {
    background: var(--ink);
    color: #fff;
    border-radius: 28px;
    padding: clamp(40px, 6vw, 72px);
    display: flex;
    flex-direction: column;
    gap: 22px;
    align-items: flex-start;
  }
  .closing-cta .headline {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: clamp(30px, 4vw, 48px);
    line-height: 1.1;
    letter-spacing: -0.8px;
    max-width: 640px;
    text-wrap: pretty;
  }
</style>
