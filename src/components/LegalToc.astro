---
import type { TocEntry } from '../data/legal-types';

interface Props {
  toc: TocEntry[];
}
const { toc } = Astro.props;
---

<nav class="toc">
  <div class="eyebrow-muted">Contents</div>
  {toc.map((t) => (
    <a href={t.href}>{t.label}</a>
  ))}
</nav>

<style>
  .toc {
    display: flex;
    flex-direction: column;
    gap: 2px;
    max-width: 300px;
  }
  /* Only pin the rail once the page is two columns. Stacked, it sits above the
     body and pinning it makes the text scroll underneath. Keep this breakpoint
     in step with .legal-body in privacy.astro and terms.astro. */
  @media (min-width: 768px) {
    .toc {
      position: sticky;
      top: 32px;
      /* On short viewports the rail is taller than the screen, so let it
         scroll on its own rather than hiding its last entries. */
      max-height: calc(100vh - 64px);
      overflow-y: auto;
    }
  }
  .eyebrow-muted {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    color: var(--ink-tertiary);
    padding-bottom: 10px;
  }
  .toc a {
    font-size: 14.5px;
    line-height: 1.45;
    color: var(--ink-secondary);
    padding: 7px 0;
    border-bottom: 1px solid #F0F2F4;
    text-decoration: none;
  }
  .toc a:hover {
    color: var(--brand);
    text-decoration: none;
  }
</style>
