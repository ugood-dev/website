---
import type { LegalSection } from '../data/legal-types';

interface Props {
  section: LegalSection;
  privacyHref?: string;
}
const { section, privacyHref = '/privacy' } = Astro.props;
---

<div id={section.id} class="section">
  <h2>{section.h}</h2>
  {section.blocks.map((b) => (
    <div class="block">
      {b.h3 && <h3>{b.h3}</h3>}
      {b.p && <p>{b.p}</p>}
      {b.email && <a href={`mailto:${b.email}`} class="inline-link">{b.email}</a>}
      {b.privacyLink && (
        <a href={privacyHref} class="inline-link">Read the U;Good? Privacy Policy →</a>
      )}
      {b.items && (
        <div class="items">
          {b.items.map((li) => (
            <div class="item">
              <span class="dot"></span>
              <span>{li}</span>
            </div>
          ))}
        </div>
      )}
    </div>
  ))}
</div>

<style>
  .section {
    display: flex;
    flex-direction: column;
    gap: 16px;
    scroll-margin-top: 32px;
  }
  h2 {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 24px;
    line-height: 1.25;
    letter-spacing: -0.4px;
  }
  .block {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  h3 {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 17px;
    letter-spacing: -0.1px;
  }
  p {
    margin: 0;
    font-size: 16px;
    line-height: 1.65;
    color: var(--ink-secondary);
    text-wrap: pretty;
  }
  .inline-link {
    font-size: 16px;
    font-weight: 600;
  }
  .items {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-left: 2px;
  }
  .item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 12px;
    align-items: start;
  }
  .dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--brand-secondary);
    margin-top: 9px;
  }
  .item span:last-child {
    font-size: 16px;
    line-height: 1.55;
    color: var(--ink-secondary);
  }
</style>
